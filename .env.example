# Referência das variáveis de ambiente. O projeto não carrega .env automaticamente.
# Configure no terminal ou no painel do provedor. Não versione sua chave real.
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Só True quando o proxy confiável sobrescreve X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HTTPS=False
